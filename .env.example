# Public application origin. Production must use HTTPS.
NEXT_PUBLIC_APP_URL=https://app.example.com

# Server-only Supabase access. Do not use NEXT_PUBLIC_ for this key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32
# Keep the key stable. Rotating it requires re-encrypting stored tokens.
FACEHOOK_ENCRYPTION_KEY=

# Meta OAuth server credentials.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Test-only variables for `pnpm verify:live-supabase`.
# Use a dedicated Meta test account and a non-production Supabase project.
FACEHOOK_TEST_APP_URL=http://localhost:3000
FACEHOOK_TEST_ACCESS_TOKEN=
